{
  "name": "point",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' --filter './tools/**' build",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "pnpm --filter @point/web test:e2e",
    "lint": "eslint . && prettier --check . && node scripts/check-brand.mjs",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "check:brand": "node scripts/check-brand.mjs",
    "db:migrate": "pnpm --filter @point/db migrate",
    "db:reset": "pnpm --filter @point/db reset",
    "db:seed": "pnpm --filter @point/db seed",
    "db:invariants": "pnpm --filter @point/db invariants",
    "db:drift": "pnpm --filter @point/db drift",
    "progress": "node tools/progress/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
