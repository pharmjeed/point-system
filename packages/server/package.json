{
  "name": "@point/server",
  "version": "0.0.0",
  "private": true,
  "description": "Domain modules, core and use-cases shared by api and worker",
  "type": "module",
  "exports": {
    ".": {
      "@point/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.1",
    "@nestjs/core": "^12.3.1",
    "@point/db": "workspace:*",
    "@point/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "testcontainers": "^12.2.1"
  }
