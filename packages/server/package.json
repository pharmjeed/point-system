{
  "name": "@point/server",
  "version": "0.0.0",
  "private": true,
  "description": "Domain modules, core and use-cases shared by api and worker",
  "type": "module",
  "exports": {
    ".": {
      "@point/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@point/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@nestjs/common": "^12.3.1",
    "@nestjs/core": "^12.3.1",
    "@point/db": "workspace:*",
    "@point/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6"
  }
}
