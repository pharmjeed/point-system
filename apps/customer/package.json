{
  "name": "@point/customer",
  "version": "0.0.0",
  "private": true,
  "description": "Customer mobile app (V2, React Native + Expo Router) — Arabic RTL first, English",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:fake": "CUSTOMER_API_MODE=fake expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "test": "vitest run --root ../.. --project customer-unit",
    "test:e2e": "playwright test",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "CUSTOMER_WEB_EXPORT=1 CUSTOMER_API_MODE=fake expo export --platform web --output-dir dist-web --clear",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "store:icon": "node scripts/store-icon.mjs",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@point/shared": "workspace:*",
    "expo": "~58.0.23",
    "expo-brightness": "~58.0.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "~1.70.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "react-native-web": "~0.21.4",
    "vitest": "^5.0.5"
  }
}
