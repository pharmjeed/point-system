{
  "name": "@point/web",
  "version": "0.0.0",
  "private": true,
  "description": "React + Vite PWA for staff (driver, supervisor, admin, owner) — Arabic RTL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "pnpm --filter @point/shared --filter @point/db --filter @point/server --filter @point/api build && E2E_BACKEND=live playwright test --project=g1-live",
    "brand:sync": "node scripts/sync-brand.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-direction": "^1.2.0",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.62.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
